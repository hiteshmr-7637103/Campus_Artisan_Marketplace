# Copy to backend/.env. Never commit the real file.
ENVIRONMENT=development            # development | production
DATABASE_URL=postgresql+psycopg://artisan:artisan@localhost:5432/artisan
JWT_SECRET=change-me-to-32-or-more-random-characters-xxxxxxxx   # python -c "import secrets;print(secrets.token_urlsafe(48))"
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000
REQUIRE_EMAIL_VERIFICATION=false      # true = verified email needed to buy, sell or review (must be true in production)
ALLOWED_EMAIL_DOMAINS=             # e.g. ssn.edu.in,snuchennai.edu.in ; empty = open signup
COMMISSION_RATE=0.10               # seed value for app_config
PAYMENT_MODE=mock                  # mock | razorpay  (mock is refused when ENVIRONMENT=production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=                    # empty = emails are printed to the console
EMAIL_FROM=Campus Artisans <onboarding@resend.dev>
UPLOAD_DIR=uploads
ALERT_EMAIL=

# ---- image storage ------------------------------------------------------------
IMAGE_STORAGE_PROVIDER=local        # local | cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=                       # optional: receives alerts on webhook failures / 5xx

# ---- payouts (3.1) -----------------------------------------------------------
PAYOUT_PROVIDER=manual              # manual | razorpayx (razorpayx not yet implemented)
PAYOUT_HOLD_HOURS=36
PAYOUT_MAX_PAISE=1000000
PAYOUT_SELLER_DAILY_CAP_PAISE=2000000
PAYOUT_PLATFORM_DAILY_CAP_PAISE=50000000
PAYOUT_NEW_SELLER_DAYS=14
PAYOUT_UPI_CHANGE_COOLDOWN_DAYS=3
PAYOUT_MAX_ATTEMPTS=3

# ---- Google sign-in + admin 2FA (3.2) -----------------------------------------
GOOGLE_CLIENT_ID=                   # both empty = Google sign-in disabled
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=change-me-to-32-or-more-random-characters-xxxxxxxx   # only used for the OAuth redirect; required in production if GOOGLE_CLIENT_ID is set
TOTP_ISSUER=Campus Artisan Marketplace
ADMIN_ACCESS_TOKEN_MINUTES=10       # shorter-lived session for admin accounts
