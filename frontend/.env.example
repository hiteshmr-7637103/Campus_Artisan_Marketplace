# Frontend environment. Copy to frontend/.env.
# Only PUBLIC values belong here: Vite inlines every VITE_* var into the shipped bundle.

# Base URL of the FastAPI backend, including the /api prefix.
VITE_API_URL=http://localhost:8000/api

# Set to "true" only once GOOGLE_CLIENT_ID/SECRET are set on the backend too.
# Keeps the "Continue with Google" button hidden until it would actually work.
VITE_GOOGLE_ENABLED=false
