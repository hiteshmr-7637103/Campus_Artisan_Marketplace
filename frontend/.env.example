# Frontend environment. Copy to frontend/.env and fill in.
#
# ONLY the public Supabase values belong here. Anything secret (service-role key,
# Razorpay secret, Resend key) lives in the edge-function env, never here — Vite
# inlines every VITE_* var into the shipped bundle. (checklist #11)

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
