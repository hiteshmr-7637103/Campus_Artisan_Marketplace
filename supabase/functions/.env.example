# Secrets for the Supabase Edge Functions.
#
# Local dev:  copy to supabase/functions/.env  (git-ignored) and run
#             `supabase functions serve --env-file supabase/functions/.env`
# Production: set each of these with
#             `supabase secrets set --env-file supabase/functions/.env`
#
# NONE of these values ever reach the browser. (checklist #5 / #11)

# --- Supabase (SUPABASE_URL is injected automatically in production; set it for local) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay (test mode until KYC is approved) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Resend (transactional email) ---
RESEND_API_KEY=
RESEND_FROM="Campus Artisan Marketplace <orders@your-domain.com>"

# --- App ---
# Shared code handed only to onboarded artisans; gates /sell submissions + uploads.
ARTISAN_SIGNUP_CODE=change-me
# Public origin of the deployed frontend, for buyer links + the Razorpay callback.
PUBLIC_SITE_URL=http://localhost:5173
